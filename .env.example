# Server Port (defaults to 3000)
PORT=3000

# Authentication & Session Security
SESSION_SECRET="change-this-to-a-secure-random-secret-in-production"
AUTH_COOKIE_NAME="mtc_session"
SESSION_TTL_HOURS=168

# Database Persistence (Supabase / PostgreSQL)
# Set DATABASE_URL, POSTGRES_URL, or POSTGRES_PRISMA_URL.
# When using Supabase on Vercel:
# 1. Supabase Integration automatically sets POSTGRES_URL / POSTGRES_PRISMA_URL
# 2. Or manually paste your Supabase Session/Transaction Pooler string below:
#    DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"
DATABASE_URL="postgresql://user:password@hostname:5432/dbname?sslmode=require"
DATABASE_FILE="./data/mtc_compliance_database.json"

# GEMINI_API_KEY: Optional API key for Google Gemini document OCR & extraction.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Optional base URL where the application is hosted.
APP_URL="http://localhost:3000"

# SEED_DEMO_DATA: Set to "true" to preload sample files & benchmark analyses, or "false" for a clean dashboard.
SEED_DEMO_DATA="true"
